# =============================================================================
# CloudVault — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================================================

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=cloudvault
POSTGRES_USER=cloudvault
POSTGRES_PASSWORD=cloudvault_secret_123
# Used by Prisma (host=postgres resolves via Docker DNS)
DATABASE_URL=postgresql://cloudvault:cloudvault_secret_123@postgres:5432/cloudvault

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO / S3-compatible Object Storage ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=cloudvault
MINIO_SECRET_KEY=cloudvault_secret_123
MINIO_BUCKET=cloudvault-files

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING_64_BYTES
JWT_EXPIRES_IN=900           # 15 minutes (access token)
REFRESH_TOKEN_EXPIRES_IN=604800  # 7 days

# ─── API Service ──────────────────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGIN=http://localhost

# ─── Notification Service ─────────────────────────────────────────────────────
NOTIFICATION_PORT=8001

# ─── Frontend (available at build time via Vite) ──────────────────────────────
# These are injected into the React bundle via Vite's import.meta.env
VITE_API_BASE_URL=/api
VITE_WS_URL=http://localhost
